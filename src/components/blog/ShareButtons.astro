---
import type { PageLang } from '../../utils/lang';

interface Props {
  title: string;
  /** Absolute URL of the article. */
  url: string;
  lang?: PageLang;
}

const { title, url, lang = 'zh' } = Astro.props;
const heading = lang === 'en' ? 'Share this post' : '分享这篇文章';
const copiedLabel = lang === 'en' ? 'Copied!' : '已复制';
---

<div class="share-buttons" data-share-root>
  <p class="share-heading">{heading}</p>
  <div class="share-row">
    <a
      class="share-btn"
      href={`https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`}
      target="_blank"
      rel="noreferrer noopener"
      aria-label="Share on X"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
      <span>X</span>
    </a>
    <button type="button" class="share-btn" data-share-copy={url} data-copied-label={copiedLabel}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <span>{lang === 'en' ? 'Copy link' : '复制链接'}</span>
    </button>
    <button type="button" class="share-btn" data-share-native hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
      </svg>
      <span>{lang === 'en' ? 'Share' : '分享'}</span>
    </button>
  </div>
</div>

<script is:inline define:vars={{ title, url }}>
  (() => {
    if (window.__styrigxShareButtons) return;
    window.__styrigxShareButtons = true;

    const showNative = () => {
      if (typeof navigator.share === 'function') {
        document
          .querySelectorAll('[data-share-native]')
          .forEach((btn) => btn.removeAttribute('hidden'));
      }
    };

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const copyBtn = target.closest('[data-share-copy]');
      if (copyBtn) {
        const link = copyBtn.getAttribute('data-share-copy') || '';
        const label = copyBtn.querySelector('span');
        const original = label ? label.textContent : '';
        try {
          await navigator.clipboard.writeText(link);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = link;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        if (label) {
          label.textContent = copyBtn.getAttribute('data-copied-label') || 'Copied';
          setTimeout(() => {
            label.textContent = original;
          }, 1600);
        }
        return;
      }

      const nativeBtn = target.closest('[data-share-native]');
      if (nativeBtn && typeof navigator.share === 'function') {
        try {
          await navigator.share({ title, url });
        } catch {}
      }
    });

    showNative();
    document.addEventListener('astro:page-load', showNative);
  })();
</script>

<style>
  .share-buttons {
    width: min(100%, var(--article-content-max, 720px));
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--paper-line);
  }

  .share-heading {
    margin: 0 0 12px;
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .share-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-control);
    color: var(--paper-ink);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .share-btn:hover {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }

  :global(.blog-layout-centered .share-buttons) {
    width: 100%;
  }
</style>
