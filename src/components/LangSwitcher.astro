---
import type { PageLang } from '../utils/lang';

interface Props {
  lang: PageLang;
  /** URL of the current page (or its counterpart) in Chinese. */
  zhHref: string;
  /** URL of the current page (or its counterpart) in English. */
  enHref: string;
}

const { lang, zhHref, enHref } = Astro.props;
const targetHref = lang === 'zh' ? enHref : zhHref;
const targetLang: PageLang = lang === 'zh' ? 'en' : 'zh';
const label = lang === 'zh' ? 'EN' : '中文';
---

<a
  href={targetHref}
  class="lang-switcher"
  data-lang-switcher
  data-target-lang={targetLang}
  aria-label={lang === 'zh' ? 'Switch to English' : '切换到中文'}
  title={lang === 'zh' ? 'English' : '中文'}
>
  {label}
</a>

<script is:inline>
  (() => {
    const KEY = 'styrigx-blog-lang';

    document.addEventListener('click', (event) => {
      const link = event.target.closest?.('[data-lang-switcher]');

      if (!link) return;

      try {
        localStorage.setItem(KEY, link.dataset.targetLang || 'zh');
      } catch {}
    });
  })();
</script>

<style>
  .lang-switcher {
    display: inline-grid;
    place-items: center;
    min-width: 38px;
    height: 38px;
    padding: 0 8px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
  }

  .lang-switcher:hover {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }
</style>
