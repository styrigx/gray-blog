---
import { getCollection, render } from 'astro:content';
import BlogArticle from '../../layouts/BlogArticle.astro';
import DoingCard from '../../components/widgets/DoingCard.astro';
import { getSiteConfig } from '../../data/site';
import { pageLangOf } from '../../utils/lang';

const entries = await getCollection('about', ({ data }) => pageLangOf(data) === 'en');
const about = entries[0];

if (!about) {
  throw new Error('Missing English about entry in src/content/en/about.mdx.');
}

const { Content, headings } = await render(about);
const siteConfig = await getSiteConfig();
const doingItems = siteConfig.home.doingEn.length > 0 ? siteConfig.home.doingEn : siteConfig.home.doing;
---

<BlogArticle
  post={about}
  headings={headings}
  lang="en"
  translationHref="/about/"
  sidebar={{ enable: false, ...about.data.sidebar }}
  contentFont="ui"
>
  <Content />
  {doingItems.length > 0 && <DoingCard items={doingItems} />}
</BlogArticle>
